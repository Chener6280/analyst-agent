# Optional development overrides. Never place credentials here.
# IR_SYSTEM_PROVIDER=ir_search
# IR_SYSTEM_PYTHON=python3
# IR_SYSTEM_IR_SEARCH_PATH=/absolute/path/to/ir_search
# IR_SYSTEM_ARCHIVE_ROOT=/absolute/path/to/ir_archive
# ZSXQ_CLI_COMMAND=/absolute/path/to/zsxq-cli
# IR_ARCHIVE_ROOT=/absolute/path/to/ir_archive
# ZSXQ_WEB_PROFILE_DIR=/absolute/path/to/dedicated-browser-profile
# CHROME_EXECUTABLE_PATH=/absolute/path/to/google-chrome
# macOS defaults to a visible dedicated browser window. Maintainer opt-in only:
# ZSXQ_WEB_HEADLESS=1
